# ---------- Server ----------
# Port the API listens on (Render/Railway inject their own PORT in production)
PORT=8000

# ---------- Database ----------
# MongoDB connection string (local mongodb://127.0.0.1:27017 or an Atlas URI).
# The database name is appended automatically ("videotube").
MONGODB_URL=mongodb://127.0.0.1:27017

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins. In production set this to
# your deployed frontend URL, e.g. https://vidora.vercel.app
CORS_ORIGIN=http://localhost:5173

# ---------- Auth tokens ----------
# Generate strong random secrets, e.g. `openssl rand -hex 64`
# Both expiry vars have code fallbacks (ACCESS_TOKEN_EXPIRY → "1d",
# REFRESH_TOKEN_EXPIRY → "10d") so a missing var can't crash logins —
# but set them explicitly in production so token lifetimes are a
# deliberate choice, not an accident of the defaults.
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=30d

# ---------- Cloudinary (media storage) ----------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ---------- Rate limiting (optional; defaults shown) ----------
# Window in milliseconds for both limiters
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window for the whole API
RATE_LIMIT_MAX=600
# Stricter cap for login / register / refresh-token / verify-email / resend
# endpoints (brute-force protection)
AUTH_RATE_LIMIT_MAX=20

# ---------- Frontend ----------
# Base URL of the deployed frontend — used to build verification / password
# reset links inside the emails sent by the backend.
FRONTEND_URL=http://localhost:5173

# ---------- Email delivery ----------
# Provider is picked automatically, first configured wins:
#   1. RESEND_API_KEY   → Resend REST API
#   2. EMAILJS_*        → EmailJS REST API (server-side, needs private key)
#   3. SMTP_*           → nodemailer
#   4. none of the above → emails are logged to the console (dev fallback),
#      so verify/reset flows still work locally.
#
# Free-tier limits (as of Sep 2026):
#   Resend : 100 emails/day · 3,000/month
#   EmailJS: ~200 emails/month
#
# RESEND NOTE — sender address:
# Sending from a custom address (e.g. no-reply@yourdomain.com) requires a
# verified domain in the Resend dashboard (DNS records). Until that is set
# up the shared test sender `onboarding@resend.dev` is used, so emails show
# a generic Resend "from" address. That is expected, NOT a bug. Resend also
# only delivers to the account owner's address while on the test sender —
# use your own inbox when testing signups. Set RESEND_FROM after verifying
# a domain to override the sender address.
RESEND_API_KEY=
RESEND_FROM=

# EmailJS (server-side): service + template from the dashboard, public key
# from Account, private key from Account → Security (required for calls
# made outside a browser).
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# SMTP (nodemailer). SMTP_FROM defaults to SMTP_USER when omitted.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
