# Copy this file to `.env` and fill in real values.
# The backend loads it automatically via dotenv (see src/index.js).

PORT=8000
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>/<dbname>

# Frontend origin allowed by CORS (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# JWT secrets — use long random strings
ACCESS_TOKEN_SECRET=your_access_token_secret
ACCESS_TOKEN_EXPIRY=10m
REFRESH_TOKEN_SECRET=your_refresh_token_secret
REFRESH_TOKEN_EXPIRY=10d

# Cloudinary (https://cloudinary.com) for video/image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
